---
import Layout from '../layouts/Layout.astro';
import SectionNav from '../components/SectionNav.astro';
import Artwork from '../components/Artwork.astro';
import { wuaLaiUrl } from '../data/links';
import '../styles/projects.css';
const sections = [
  { id: 'overall', label: 'Overall' },
  { id: 'why-wua-lai', label: 'Why Wua-lai' },
  { id: 'how-it-works', label: 'How it works' },
  { id: 'design-interaction', label: 'Design & Interaction' },
  { id: 'reflection', label: 'Reflection' },
];
---
<Layout title="The Echoes of Wua-lai — Pitchayapa Thiamtamanee" description="The Echoes of Wua-lai is an interactive sound map that transforms everyday activity data in Wua-lai, Chiang Mai, into an evolving soundscape.">
  <SectionNav sections={sections} />
  <main id="main" class="case-study wua-lai">
    <section id="overall" class="overall case-section" aria-labelledby="project-title">
      <h1 id="project-title" class="project-title">THE ECHOES OF WUA-LAI<br />PROJECTS</h1>
      <Artwork name="wua-lai-laptop" alt="The Echoes of Wua-lai interactive sound map displayed on a laptop" width={673} height={376} class="wua-lai-hero" eager />
      <p class="project-description">The Echoes of Wua-lai is an interactive sound map that transforms everyday activity data in Wua-lai, Chiang Mai, into an evolving soundscape.</p>
      <div class="visit"><a class="button" href={wuaLaiUrl} target="_blank" rel="noopener noreferrer">VISIT WEBSITE <span aria-hidden="true">⟶</span></a></div>
    </section>
    <!-- The supplied export is blank below the overview. At the user's
         request, preserve the navigation and empty anchor destinations. -->
    {sections.slice(1).map(({ id, label }) => <section id={id} class="empty-section" aria-label={label}></section>)}
  </main>
</Layout>
